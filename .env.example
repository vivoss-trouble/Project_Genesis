# Genesis v1 environment template

# Core Sense target. Fantasy Dummy defaults:
GENESIS_SENSE_URL=http://127.0.0.1:4767/state
GENESIS_SENSE_KEY=fantasy_state

# v3 Planner/JIT cursor. When set, Sense injects macro_goal; the Brain daemon
# may draft a plan and compile its currently active step into an allowlisted action.
# GENESIS_MACRO_GOAL="restore system health while respecting all allowlists"

# Web Arena mode:
# GENESIS_ARENA=web
# GENESIS_SENSE_URL=http://127.0.0.1:4777/state
# GENESIS_SENSE_KEY=web_state
# GENESIS_WEB_URL=https://example.com
# GENESIS_WEB_ALLOWED_ORIGINS=https://example.com,https://www.iana.org,https://iana.org
# GENESIS_WEB_ALLOWED_SELECTORS=a
# GENESIS_WEB_OBSERVED_SELECTORS=a,body
# GENESIS_WEB_STATE_TIMEOUT_MS=300
# GENESIS_WEB_ACTION_TIMEOUT_MS=5000
# GENESIS_WEB_REFRESH_SEC=1.0
# GENESIS_WEB_ACTION_QUEUE=32
# GENESIS_WEB_ARENA_HOST=127.0.0.1
# GENESIS_WEB_ARENA_PORT=4777
# GENESIS_ACT_SOCKET=/tmp/genesis_act.sock
# GENESIS_WEB_HEADLESS=1
# Safety/test-only: force HTTP probe mode even if Playwright is installed.
# GENESIS_WEB_FORCE_READ_ONLY=1

# LLM daemon. Leave GENESIS_MODEL_PATH unset for deterministic fallback.
# GENESIS_MODEL_PATH=/absolute/path/model.gguf
GENESIS_N_GPU_LAYERS=-1
GENESIS_N_CTX=2048
GENESIS_N_THREADS=8
GENESIS_LLM_LATENCY_SEC=0.2

# Purifier/action allowlist. Keep aligned with Web Arena selectors.
# GENESIS_ALLOWED_CLICK_TARGETS=a
# v3.3 one-tick verifiable Wait selectors. Keep aligned with observed selectors.
# GENESIS_ALLOWED_WAIT_SELECTORS=a

# Test-only: force deterministic web fallback to click first allowlisted target.
# Do not enable for normal model validation.
# GENESIS_WEB_FALLBACK_CLICK=1
# GENESIS_WEB_FALLBACK_WAIT_SELECTOR=a
# GENESIS_WEB_FALLBACK_WAIT_MS=1000

# v3.4 prompt-only read model advisory. When configured, the Brain daemon may
# read bounded failure counts for the active allowlisted selector. This never
# grants execution rights and the core never reads SQLite.
# GENESIS_ADVISORY_DB=/absolute/path/audit.sqlite
# GENESIS_ADVISORY_SAMPLE_LIMIT=25
# GENESIS_ADVISORY_QUERY_MS=50

# Validation toggles.
# GENESIS_VALIDATE_LIVE_FIRE=1

# Not yet configurable in v1:
# - Core Tick interval is fixed at 2000ms.
# - Plugin Watchdog deadline is fixed at 15ms.
