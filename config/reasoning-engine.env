# Genesis local reasoning engine defaults.
#
# This file is intentionally safe to commit: it contains no API keys.
# Local release validation still requires NVD_API_KEY in the caller environment.

if [ -z "${GENESIS_REASONING_KERNEL+x}" ]; then
  GENESIS_REASONING_KERNEL=DAO-LAW-SINGULARITY-KERNEL-V4.2
fi
if [ -z "${LAZARUS_LM_ENDPOINT+x}" ]; then
  LAZARUS_LM_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
fi
if [ -z "${LAZARUS_LM_MODEL+x}" ]; then
  LAZARUS_LM_MODEL=huihui-ai/qwen/claude-4.7-opus-q8_0.gguf
fi
if [ -z "${LAZARUS_ORACLE_PROTOCOL+x}" ]; then
  LAZARUS_ORACLE_PROTOCOL=openai_chat
fi
if [ -z "${LAZARUS_ORACLE_MAX_RETRIES+x}" ]; then
  LAZARUS_ORACLE_MAX_RETRIES=1
fi
if [ -z "${LAZARUS_ORACLE_TIMEOUT_MS+x}" ]; then
  LAZARUS_ORACLE_TIMEOUT_MS=120000
fi
if [ -z "${LAZARUS_ORACLE_MAX_OUTPUT_TOKENS+x}" ]; then
  LAZARUS_ORACLE_MAX_OUTPUT_TOKENS=4096
fi

export GENESIS_REASONING_KERNEL
export LAZARUS_LM_ENDPOINT
export LAZARUS_LM_MODEL
export LAZARUS_ORACLE_PROTOCOL
export LAZARUS_ORACLE_MAX_RETRIES
export LAZARUS_ORACLE_TIMEOUT_MS
export LAZARUS_ORACLE_MAX_OUTPUT_TOKENS
